datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  CASHIER
  KITCHEN
}

enum OrderType {
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Restaurant {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @default("مطعم ضجة") @db.VarChar(255)
  tagline         String?     @default("طعم يعمل ضجة! 🔥") @db.VarChar(255)
  logoUrl         String?     @map("logo_url") @db.Text
  phone           String?     @default("01000000000") @db.VarChar(50)
  address         String?     @default("القاهرة - مصر") @db.VarChar(255)
  deliveryFee     Decimal     @default(15.00) @map("delivery_fee") @db.Decimal(10, 2)
  isOpen          Boolean     @default(true) @map("is_open")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  users           User[]
  categories      Category[]
  menuItems       MenuItem[]
  orders          Order[]
  captains        Captain[]

  @@map("restaurants")
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  role         Role        @default(RESTAURANT_ADMIN)
  restaurantId String?     @map("restaurant_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("users")
}

model Category {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  name         String      @db.VarChar(100)
  icon         String?     @default("🍔") @db.VarChar(20)
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([restaurantId])
  @@map("categories")
}

model MenuItem {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  name         String      @db.VarChar(150)
  description  String?     @db.Text
  price        Decimal     @db.Decimal(10, 2)
  imageUrl     String?     @map("image_url") @db.Text
  isAvailable  Boolean     @default(true) @map("is_available")
  badge        String?     @db.VarChar(50)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model Captain {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  name         String      @db.VarChar(100)
  phone        String      @db.VarChar(50)
  vehicleType  String?     @default("موتوسيكل") @map("vehicle_type") @db.VarChar(50)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([restaurantId])
  @@map("captains")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number") @db.VarChar(50)
  restaurantId    String        @map("restaurant_id") @db.Uuid
  orderType       OrderType     @default(DELIVERY) @map("order_type")
  customerName    String        @map("customer_name") @db.VarChar(150)
  customerPhone   String        @map("customer_phone") @db.VarChar(50)
  deliveryAddress String?       @map("delivery_address") @db.Text
  notes           String?       @db.Text
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  captainId       String?       @map("captain_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  captain         Captain?      @relation(fields: [captainId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@index([restaurantId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  name       String   @db.VarChar(150)
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  notes      String?  @db.VarChar(255)

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}
