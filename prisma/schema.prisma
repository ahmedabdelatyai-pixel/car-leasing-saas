datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  CASHIER
  KITCHEN
}

enum OrderType {
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Restaurant {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @default("مطعم ضجة") @db.VarChar(255)
  tagline         String?     @default("الأكل طعمه حكاية 🔥") @db.VarChar(255)
  logoUrl         String?     @map("logo_url") @db.Text
  phone           String?     @default("01210783175 - 01272022986") @db.VarChar(100)
  whatsappNumber  String?     @default("01210783175") @map("whatsapp_number") @db.VarChar(50)
  address         String?     @default("ارض الفضالي موازي لشارع 34 متفرع من ش مسجد حمزه برج عماد الرحمن 3 ب") @db.VarChar(255)
  deliveryFee     Decimal     @default(15.00) @map("delivery_fee") @db.Decimal(10, 2)
  minOrderAmount  Decimal     @default(0.00) @map("min_order_amount") @db.Decimal(10, 2)
  estimatedTime   String?     @default("30 - 45 دقيقة") @map("estimated_time") @db.VarChar(50)
  allowDelivery   Boolean     @default(true) @map("allow_delivery")
  allowTakeaway   Boolean     @default(true) @map("allow_takeaway")
  receiptFooter   String?     @default("شكراً لاختياركم مطعم ضجة! 🔥") @map("receipt_footer") @db.VarChar(255)
  isOpen          Boolean     @default(true) @map("is_open")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  users           User[]
  categories      Category[]
  menuItems       MenuItem[]
  orders          Order[]
  captains        Captain[]
  dailyClosures   DailyClosure[]

  @@map("restaurants")
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique @db.VarChar(255)
  fullName     String?     @default("مدير مطعم ضجة") @map("full_name") @db.VarChar(150)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  role         Role        @default(RESTAURANT_ADMIN)
  restaurantId String?     @map("restaurant_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("users")
}

model Category {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  name         String      @db.VarChar(100)
  icon         String?     @default("🍔") @db.VarChar(20)
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([restaurantId])
  @@map("categories")
}

model MenuItem {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  name         String      @db.VarChar(150)
  description  String?     @db.Text
  price        Decimal     @db.Decimal(10, 2)
  imageUrl     String?     @map("image_url") @db.Text
  isAvailable  Boolean     @default(true) @map("is_available")
  badge        String?     @db.VarChar(50)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model Captain {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  name         String      @db.VarChar(100)
  phone        String      @db.VarChar(50)
  vehicleType  String?     @default("موتوسيكل") @map("vehicle_type") @db.VarChar(50)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([restaurantId])
  @@map("captains")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number") @db.VarChar(50)
  restaurantId    String        @map("restaurant_id") @db.Uuid
  orderType       OrderType     @default(DELIVERY) @map("order_type")
  customerName    String        @map("customer_name") @db.VarChar(150)
  customerPhone   String        @map("customer_phone") @db.VarChar(50)
  deliveryAddress String?       @map("delivery_address") @db.Text
  notes           String?       @db.Text
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  captainId       String?       @map("captain_id") @db.Uuid
  closureId       String?       @map("closure_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  captain         Captain?      @relation(fields: [captainId], references: [id], onDelete: SetNull)
  dailyClosure    DailyClosure? @relation(fields: [closureId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@index([restaurantId])
  @@index([status])
  @@index([orderNumber])
  @@index([closureId])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  name       String   @db.VarChar(150)
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  notes      String?  @db.VarChar(255)

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model DailyClosure {
  id              String      @id @default(uuid()) @db.Uuid
  restaurantId    String      @map("restaurant_id") @db.Uuid
  closureDate     DateTime    @default(now()) @map("closure_date")
  openedAt        DateTime    @default(now()) @map("opened_at")
  closedAt        DateTime    @default(now()) @map("closed_at")
  totalSales      Decimal     @default(0.00) @map("total_sales") @db.Decimal(10, 2)
  orderCount      Int         @default(0) @map("order_count")
  deliverySales   Decimal     @default(0.00) @map("delivery_sales") @db.Decimal(10, 2)
  takeawaySales   Decimal     @default(0.00) @map("takeaway_sales") @db.Decimal(10, 2)
  deliveryCount   Int         @default(0) @map("delivery_count")
  takeawayCount   Int         @default(0) @map("takeaway_count")
  itemsBreakdown  Json?       @map("items_breakdown")
  closedBy        String?     @map("closed_by") @db.VarChar(150)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")

  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([restaurantId])
  @@index([closureDate])
  @@map("daily_closures")
}

